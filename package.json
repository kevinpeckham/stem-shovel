{
	"name": "stem-shovel",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp check",
		"format": "vp fmt",
		"stems": "node scripts/make-test-stems.mjs",
		"smoke:blob": "node scripts/blob-smoke.mjs",
		"shot": "varlock run -- node scripts/screenshot.mjs",
		"db:generate": "varlock run -- drizzle-kit generate",
		"db:migrate": "varlock run -- drizzle-kit migrate",
		"db:studio": "varlock run -- drizzle-kit studio",
		"db:seed": "varlock run -- bun scripts/seed.ts",
		"db:set-password": "varlock run -- bun scripts/set-password.ts",
		"db:preview-bot": "varlock run -- bun scripts/preview-bot.ts"
	},
	"dependencies": {
		"@kevinpeckham/barkdown": "0.1.1",
		"@kevinpeckham/woof-editor": "0.2.1",
		"@libsql/client": "0.18.0",
		"@varlock/1password-plugin": "^2.0.4",
		"@vercel/blob": "2.8.0",
		"better-auth": "^1.7.4",
		"client-zip": "^2.5.0",
		"drizzle-orm": "0.45.2",
		"isomorphic-dompurify": "^4.2.0",
		"marked": "18.0.5",
		"marked-footnote": "^1.4.0",
		"nanoid": "6.0.1",
		"parse5": "^8.0.1",
		"valibot": "^1.5.0",
		"varlock": "^1.18.0"
	},
	"devDependencies": {
		"@iconify-json/ph": "^1.2.2",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@unocss/extractor-svelte": "^66.10.2",
		"@unocss/preset-wind4": "^66.10.2",
		"@unocss/reset": "^66.10.2",
		"@varlock/vite-integration": "1.5.1",
		"devalue": "^5.9.2",
		"drizzle-kit": "0.31.10",
		"fallow": "3.25.0",
		"playwright": "^1.63.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"unocss": "^66.10.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
		"vite-plus": "0.3.1"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
	},
	"packageManager": "bun@1.4.2"
}
