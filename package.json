{
	"name": "stem-shovel",
	"version": "0.121.0",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp check",
		"spell": "cspell --no-progress",
		"format": "vp fmt",
		"stems": "node scripts/make-test-stems.mjs",
		"samples:piano": "varlock run -- bun scripts/piano-samples.ts",
		"samples:bass": "bun scripts/instrument-samples.ts bass",
		"samples:guitar": "bun scripts/instrument-samples.ts guitar",
		"smoke:blob": "node scripts/blob-smoke.mjs",
		"smoke:urls": "varlock run -- node scripts/smoke-urls.mjs",
		"check:swing": "varlock run -- node scripts/drum-swing-check.mjs",
		"shot": "varlock run -- node scripts/screenshot.mjs",
		"db:generate": "varlock run -- drizzle-kit generate",
		"db:migrate": "varlock run -- drizzle-kit migrate",
		"db:status": "varlock run -- bun scripts/migration-status.ts",
		"db:studio": "varlock run -- drizzle-kit studio",
		"db:seed": "varlock run -- bun scripts/seed.ts",
		"db:set-password": "varlock run -- bun scripts/set-password.ts",
		"db:preview-bot": "varlock run -- bun scripts/preview-bot.ts",
		"db:system-admin": "varlock run -- bun scripts/system-admin.ts",
		"db:super-admin": "varlock run -- bun scripts/super-admin.ts",
		"db:seed-docs": "varlock run -- bun scripts/seed-user-docs.ts",
		"db:update-docs": "varlock run -- bun scripts/update-user-docs.ts",
		"db:sweep-orphans": "varlock run -- bun scripts/sweep-orphans.ts",
		"db:reset-stage": "varlock run -- bun scripts/reset-stage.ts",
		"db:snapshot-accounts": "varlock run -- bun scripts/snapshot-accounts.ts",
		"db:restore-accounts": "varlock run -- bun scripts/restore-accounts.ts",
		"db:copy-database": "varlock run -- bun scripts/copy-database.ts",
		"test": "vp test run",
		"test:watch": "vp test watch",
		"test:unit": "vp test run --project unit",
		"test:components": "vp test run --project components",
		"test:coverage": "vp test run --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@ai-sdk/gateway": "^4.0.82",
		"@better-auth/passkey": "^1.7.5",
		"@kevinpeckham/barkdown": "0.1.1",
		"@kevinpeckham/woof-editor": "0.2.1",
		"@libsql/client": "0.18.0",
		"@sentry/node": "11.5.0",
		"@sentry/sveltekit": "^11.5.0",
		"@spotify/basic-pitch": "^1.0.1",
		"@varlock/1password-plugin": "^2.0.4",
		"@vercel/analytics": "^2.0.1",
		"@vercel/blob": "2.8.0",
		"@vercel/speed-insights": "^2.0.0",
		"ai": "^7.0.102",
		"better-auth": "^1.7.4",
		"client-zip": "^2.5.0",
		"drizzle-orm": "0.45.2",
		"fflate": "^0.8.3",
		"ffmpeg-static": "^5.3.0",
		"isomorphic-dompurify": "^4.2.0",
		"marked": "18.0.5",
		"marked-footnote": "^1.4.0",
		"nanoid": "6.0.1",
		"parse5": "^8.0.1",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.4.299",
		"pdfkit": "^0.20.2",
		"qrcode": "1.5.4",
		"resend": "^6.28.0",
		"svg-to-pdfkit": "^0.1.8",
		"valibot": "^1.5.0",
		"varlock": "^1.18.0",
		"verovio": "^6.3.0"
	},
	"devDependencies": {
		"@iconify-json/ph": "^1.2.2",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/pdfkit": "^0.17.6",
		"@types/qrcode": "1.5.6",
		"@types/svg-to-pdfkit": "^0.1.4",
		"@unocss/extractor-svelte": "^66.10.2",
		"@unocss/preset-wind4": "^66.10.2",
		"@unocss/reset": "^66.10.2",
		"@varlock/vite-integration": "1.5.1",
		"@vitest/coverage-v8": "5.0.3",
		"cspell": "^10.3.3",
		"devalue": "^5.9.2",
		"drizzle-kit": "0.31.10",
		"fake-indexeddb": "^6.2.5",
		"fallow": "3.25.0",
		"jsdom": "^30.0.1",
		"playwright": "^1.63.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"unocss": "^66.10.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
		"vite-plus": "1.1.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
	},
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"ffmpeg-static"
	]
}
