{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "npx --yes bun@1.4.2 install --frozen-lockfile",
	"crons": [
		{ "path": "/api/warm", "schedule": "*/5 * * * *" },
		{ "path": "/api/notifications/digest", "schedule": "0 13 * * *" }
	],
	"redirects": [
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "fifths.app" }],
			"destination": "https://www.stemshovel.com/chord-player",
			"permanent": true
		},
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "chordplayer.dev" }],
			"destination": "https://www.stemshovel.com/chord-player",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "same-origin"
				},
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=31536000; includeSubDomains; preload"
				},
				{
					"key": "Permissions-Policy",
					"value": "accelerometer=(), camera=(), display-capture=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), midi=(self), payment=(), publickey-credentials-get=(self), screen-wake-lock=(self), serial=(), usb=(), xr-spatial-tracking=(), hid=(), idle-detection=()"
				}
			]
		},
		{
			"source": "/((?!docs|blog|releases|tuner$|metronome$|drum-machine$|piano$|chord-player$|looper$|pricing$|built-with$).+)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow, noarchive"
				}
			]
		}
	]
}
