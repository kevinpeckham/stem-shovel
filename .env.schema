# Stem Shovel environment schema — https://varlock.dev
#
# Every variable the app reads is declared here. Secrets live in a 1Password
# environment and are loaded through the 1Password plugin, so nothing sensitive
# is stored in Vercel's env vars except the service-account token used to
# reach 1Password. Local overrides go in .env.local (gitignored).
#
# @defaultRequired=true
# @defaultSensitive=true
# @generateTsTypes(path=./src/env.d.ts)
# @currentEnv=$APP_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN)
# @setValuesBulk(opLoadEnvironment($OP_ENV_ID))
# @encryptInjectedEnv=forEnv(preview, production)
# ---

# Set by Vercel on every deployment; absent locally.
# @optional @sensitive=false
VERCEL_ENV=

# Which environment-specific .env files load, and the value of forEnv().
# @type=enum(development, preview, production) @sensitive=false
APP_ENV=fallback($VERCEL_ENV, development)

# 1Password service-account token. Vercel env var in preview/production,
# .env.local for development.
# @type=opServiceAccountToken @internal
OP_TOKEN=

# ID of the 1Password environment that supplies the values below.
# @sensitive=false @internal
OP_ENV_ID=

# Vercel Blob store — https://vercel.com/docs/vercel-blob
# Long-lived read-write token; needed by handleUpload() for browser uploads.
BLOB_READ_WRITE_TOKEN=
# @sensitive=false
BLOB_STORE_ID=
# Verifies onUploadCompleted webhooks from Vercel Blob.
# @sensitive=false
BLOB_WEBHOOK_PUBLIC_KEY=
