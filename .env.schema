# Stem Shovel environment schema — https://varlock.dev
#
# Every variable the app reads is declared here. Secrets live in a 1Password
# environment and are loaded through the 1Password plugin, so nothing sensitive
# is stored in Vercel's env vars except the service-account token used to
# reach 1Password. Local overrides go in .env.local (gitignored).
#
# @defaultRequired=true
# @defaultSensitive=true
# @generateTsTypes(path=./src/env.d.ts)
# @currentEnv=$APP_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN)
# @setValuesBulk(opLoadEnvironment($OP_ENV_ID))
# @encryptInjectedEnv=forEnv(preview, production)
# ---

# Set by Vercel on every deployment; absent locally. Declared so varlock's
# leak scanner knows they are not secrets (undeclared values are treated as
# sensitive, which trips the scanner when SvelteKit sends HTML to the browser).
# @optional @sensitive=false
VERCEL_ENV=
# Production hostname (no protocol). Vercel Blob uses it for the
# onUploadCompleted callback URL, read directly from process.env.
# @optional @sensitive=false
VERCEL_PROJECT_PRODUCTION_URL=
# The commit Vercel is building; the footer shows its short form (vite.config.ts).
# @optional @sensitive=false
VERCEL_GIT_COMMIT_SHA=
# Short-lived token Vercel injects at build and runtime, and `vercel env pull`
# writes to .env.local. We never use it (Blob calls pass the token explicitly)
# but it must be declared as sensitive so it is never treated as public.
# @optional
VERCEL_OIDC_TOKEN=

# Which environment-specific .env files load, and the value of forEnv().
# @type=enum(development, preview, production) @sensitive=false
APP_ENV=fallback($VERCEL_ENV, development)

# 1Password service-account token. Vercel env var in preview/production,
# .env.local for development.
# @type=opServiceAccountToken @internal
OP_TOKEN=

# ID of the 1Password environment that supplies the values below: one per
# stage (docs/environments.md) — .env.local names the dev one, Vercel's
# Preview scope the staging one, Production today's.
# @sensitive=false @internal
OP_ENV_ID=

# Vercel Blob store — https://vercel.com/docs/vercel-blob
# Long-lived read-write token; needed by handleUpload() for browser uploads.
BLOB_READ_WRITE_TOKEN=
# @sensitive=false
BLOB_STORE_ID=
# Private Blob store for the files of private songs (docs/uploads-and-blob.md):
# its own read-write token, store id and webhook key. Optional so a deploy
# without them still runs; without the token, private songs keep their files
# where they are and the relocation logs an error.
# @optional
BLOB_PRIVATE_READ_WRITE_TOKEN=
# @optional @sensitive=false
BLOB_PRIVATE_WEBHOOK_PUBLIC_KEY=
# @optional @sensitive=false
BLOB_PRIVATE_STORE_ID=
# Verifies onUploadCompleted webhooks from Vercel Blob.
# @sensitive=false
BLOB_WEBHOOK_PUBLIC_KEY=

# Turso (libSQL) — https://docs.turso.tech
# @type=url @sensitive=false
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Better Auth — https://www.better-auth.com
# Signs session cookies/tokens; 32+ random bytes (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=

# Screenshot auth bypass (src/lib/server/previewAuth.ts). A request presenting
# this exact token (header `x-preview-token` or cookie `preview_token`) is the
# Screenshot Bot user, so `bun run shot` can capture members-only pages.
# Leave EMPTY to disable the bypass (fail-closed); values under 32 characters
# are ignored. Set in the dev and staging 1Password environments (or
# .env.local), never in production's, so production stays closed to the bot.
# @optional
PREVIEW_AUTH_TOKEN=

# Vercel AI Gateway — https://vercel.com/docs/ai-gateway — the "Ask AI" second
# opinion on a song's tempo, key and time signature (src/lib/server/aiDetect.ts).
# Optional: without it the button is not shown.
# @optional
AI_GATEWAY_API_KEY=

# Resend — https://resend.com — transactional email: address verification,
# password reset, invitations, share-by-email. The domain is verified in Resend;
# mail goes out as no-reply@<domain>.
RESEND_API_KEY=
# @sensitive=false
RESEND_MAIL_DOMAIN=

# Sentry — https://sentry.io — error reports from the browser and the server
# (src/hooks.client.ts, src/instrumentation.server.ts; the DSN is public and
# inline there). The auth token is build-time only: Vercel builds upload
# source maps with it (vite.config.ts). It lives in the 1Password environment
# like the other secrets; the Vite integration puts the resolved env into
# process.env as soon as it is imported, before the Sentry plugin is created.
# Local builds never upload.
# @optional
SENTRY_AUTH_TOKEN=
